{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "app-watch/agent",
    "description": "App Watch agent: records telemetry inside monitored Laravel apps and ships it to the App Watch monitor.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "AppWatch\\Agent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppWatch\\Agent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AppWatch\\Agent\\AppWatchAgentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
